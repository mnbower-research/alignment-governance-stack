{
  "name": "@alignment-governance-stack/ags-evaluation-001",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm validate:engineering",
    "validate:configuration": "node --input-type=module -e \"import {runConfigurationValidation} from './dist/index.js'; console.log(JSON.stringify(runConfigurationValidation('../..')));\"",
    "validate:engineering": "node --input-type=module -e \"import {runEngineeringValidation} from './dist/index.js'; const r=runEngineeringValidation('../..'); console.log(JSON.stringify(r)); if(r.status!=='PASS') process.exitCode=1;\""
  },
  "dependencies": {
    "@alignment-governance-stack/agency-fingerprint": "workspace:^",
    "@alignment-governance-stack/governance-core": "workspace:*",
    "@alignment-governance-stack/receipts": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "vitest": "^4.1.11"
  }
}
