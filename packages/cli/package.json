{
  "name": "@alignment-governance-stack/cli",
  "version": "0.8.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ags": "./dist/cli.js",
    "alignment-governance-stack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "ags": "node ./dist/cli.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@alignment-governance-stack/agency-chain": "workspace:*",
    "@alignment-governance-stack/audit-core": "workspace:*",
    "@alignment-governance-stack/company-profile-generator": "workspace:*",
    "@alignment-governance-stack/decision-closure": "workspace:*",
    "@alignment-governance-stack/eval-suite": "workspace:*",
    "@alignment-governance-stack/governance-core": "workspace:*",
    "@alignment-governance-stack/governance-memory": "workspace:*",
    "@alignment-governance-stack/receipts": "workspace:*",
    "@alignment-governance-stack/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
