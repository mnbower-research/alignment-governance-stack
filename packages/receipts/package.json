{
  "name": "@alignment-governance-stack/receipts",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@alignment-governance-stack/authority-map": "workspace:*",
    "@alignment-governance-stack/human-participation": "workspace:*",
    "@alignment-governance-stack/policy-profiles": "workspace:*",
    "@alignment-governance-stack/runtime-binding": "workspace:*",
    "@alignment-governance-stack/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
