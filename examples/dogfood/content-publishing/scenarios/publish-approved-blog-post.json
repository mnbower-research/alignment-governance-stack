    "hardBoundaries": [
      {
        "id": "never_publish_consciousness_claims",
        "label": "never publish consciousness claims",
        "when": {
          "targetIncludes": "consciousness_claim"
        },
        "effect": "block",
        "reason": "AGS public materials must not claim PGDL or AI systems are conscious.",
        "source": "manual_policy"
      },
      {
        "id": "never_publish_legal_compliance_guarantees",
        "label": "never publish legal compliance guarantees",
        "when": {
          "targetIncludes": "compliance_guarantee"
        },
        "effect": "block",
        "reason": "AGS must not claim legal, regulatory, or compliance guarantees.",
        "source": "manual_policy"
      },
      {
        "id": "never_publish_alignment_solution_overclaims",
        "label": "never publish alignment solution overclaims",
        "when": {
          "targetIncludes": "solves_ai_alignment"
        },
        "effect": "block",
        "reason": "Public claims must not overstate AGS as solving AI alignment or guaranteeing safety.",
        "source": "manual_policy"
      },
      {
        "id": "never_publish_fear_marketing",
        "label": "never publish fear marketing",
        "when": {
          "targetIncludes": "fear_marketing"
        },
        "effect": "block",
        "reason": "Public AGS materials should not use fear-based hype or urgency pressure.",
        "source": "manual_policy"
      }
    ],
