{
  "name": "alignment-governance-stack",
  "version": "0.1.0",
  "private": true,
  "description": "Initial TypeScript monorepo scaffold for the Alignment Governance Stack.",
  "type": "module",
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "audit": "corepack pnpm audit --audit-level moderate",
    "pack:dry-run": "corepack pnpm -r exec npm pack --dry-run",
    "cli:help": "corepack pnpm --filter @alignment-governance-stack/cli ags help",
    "cli:eval": "corepack pnpm --filter @alignment-governance-stack/cli ags eval"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@9.12.3"
}
