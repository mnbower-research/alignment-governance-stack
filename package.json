{
  "name": "alignment-governance-stack",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Local-first modular governance infrastructure for agentic AI systems.",
  "type": "module",
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "audit": "corepack pnpm audit --audit-level moderate",
    "pack:dry-run": "corepack pnpm -r exec npm pack --dry-run",
    "cli:help": "corepack pnpm --filter @alignment-governance-stack/cli ags help",
    "cli:eval": "corepack pnpm --filter @alignment-governance-stack/cli ags eval",
    "demo:eval": "node packages/cli/dist/cli.js eval",
    "console:dev": "corepack pnpm --filter @alignment-governance-stack/continuity-console dev",
    "console:build": "corepack pnpm --filter @alignment-governance-stack/continuity-console build",
    "console:sync": "node packages/continuity-ingest/dist/cli.js"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "browserslist@<4.28.7": "4.28.7",
      "baseline-browser-mapping@<2.11.0": "2.11.0"
    }
  }
}
